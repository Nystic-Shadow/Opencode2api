# OpenCode2API environment (proxy-only mode)
PORT=8080
DASHBOARD_USER=admin

# Required by docker-compose. Use 12+ characters; known defaults such as
# "admin123" are ignored. Generate one with: openssl rand -base64 24
DASHBOARD_PASS=

# Required: comma-separated explicit HTTP, HTTPS, or SOCKS5 proxies.
# These are the only inference egress routes. Public proxy lists are not used.
# PROXIES=socks5://user:pass@proxy-a.example:1080,http://user:pass@proxy-b.example:8080
PROXIES=

# Proxy-only / fail-closed egress
EGRESS_MODE=proxy_only
ALLOW_DIRECT_FALLBACK=false
WARP_ENGINE=disabled
WARP_MODE=disabled

# Optional tuning
# MAX_RETRIES=2
# REQUEST_TIMEOUT_MS=30000
# REQUEST_DEADLINE_MS=90000
# QUEUE_MAX_CONCURRENT=8
# QUEUE_MAX_PER_KEY=4
# QUEUE_MAX_SIZE=100
# QUEUE_WAIT_MS=15000

# Optional: override the upstream chat endpoint for a compatible mirror or a
# local test server. Plain HTTP is only allowed with direct egress.
# UPSTREAM_INFERENCE_URL=https://opencode.ai/inference/v1/chat/completions
