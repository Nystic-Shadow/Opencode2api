# OpenCode2API environment
PORT=8080
DASHBOARD_USER=admin

# Required by docker-compose. Use 12+ characters; known defaults such as
# "admin123" are ignored. Generate one with: openssl rand -base64 24
DASHBOARD_PASS=

# Optional: comma-separated user-owned proxies. These are preferred after WARP
# and are never scraped from public lists.
# PROXIES=socks5://user:pass@host:1080,http://host:8080

# The compose file runs WARP as a sidecar and disables direct fallback so the
# gateway cannot silently leak the host IP. Override only if you know why.
# WARP_ENGINE=sidecar
# WARP_HOST=warp
# WARP_PORT=1080
# WARP_MODE=always
# ALLOW_DIRECT_FALLBACK=false

# Optional tuning
# MAX_RETRIES=2
# REQUEST_TIMEOUT_MS=30000
# REQUEST_DEADLINE_MS=90000
# QUEUE_MAX_CONCURRENT=8
# QUEUE_MAX_PER_KEY=4
# QUEUE_MAX_SIZE=100
# QUEUE_WAIT_MS=15000

# Optional: override the upstream chat endpoint for a compatible mirror or a
# local test server. Plain HTTP is only allowed with direct egress.
# UPSTREAM_INFERENCE_URL=https://opencode.ai/inference/v1/chat/completions
