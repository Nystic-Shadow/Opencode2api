# OpenCode2API environment
#
# That is all you need. Egress proxies are discovered, verified, rotated, and
# pruned automatically; do not configure PROXIES unless you want to add your
# own routes. Every route must pass five consecutive TLS probes before use.

PORT=8080
DASHBOARD_USER=admin

# Required by docker-compose. Use 12+ characters; known defaults such as
# "admin123" are ignored. Generate one with: openssl rand -base64 24
DASHBOARD_PASS=

# Dedicated Rotating Proxy Gateway (Optional)
# If you have a rotating proxy (e.g., Webshare, Smartproxy, Oxylabs, BrightData, IPRoyal)
# Toggle ROTATING_PROXY_ENABLED=true and set the single backconnect proxy URL.
# The gateway will route all upstream inference through it, forcing a fresh exit IP per request
# and completely bypassing IP rate limits and quota lockouts.
# ROTATING_PROXY_ENABLED=false
# ROTATING_PROXY_URL=http://user:pass@p.webshare.io:80
# ROTATING_PROXY_SESSION_MODE=auto # auto | session_suffix | disabled

