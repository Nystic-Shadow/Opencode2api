# OpenCode2API environment
#
# That is all you need. Egress proxies are discovered, verified, rotated, and
# pruned automatically; do not configure PROXIES unless you want to add your
# own routes. Every route must pass five consecutive TLS probes before use.

PORT=8080
DASHBOARD_USER=admin

# Required by docker-compose. Use 12+ characters; known defaults such as
# "admin123" are ignored. Generate one with: openssl rand -base64 24
DASHBOARD_PASS=
